# Copy to .env (or export these) before starting the API. Paths are relative to the ml-api folder.
FS_MODEL_DIR=../ml/artifacts/final_model
FS_ML_PACKAGE_DIR=../ml
FS_PROJECTION_CARD=../ml/artifacts/projections/projection_card.json
FS_CUBE_PATH=data/cube.npz
# Results of the Phase 2 checks (which features leave the experimental label)
FS_V3_DIR=../ml/artifacts/v3_era5_rain
FS_API_CHECKS=../ml/artifacts/api_validation/checks.json
# Comma-separated web origins allowed to call the API (the Vite dev server)
ML_API_CORS_ORIGINS=http://localhost:5173,http://localhost:5174
ML_API_LOG_LEVEL=info

# Sprout's open questions (POST /api/v1/ask). Any OpenAI-compatible chat endpoint; the key stays on the server.
# Free, local: Ollama (https://ollama.com) -> ollama pull qwen2.5:3b
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen2.5:3b
LLM_API_KEY=
# Free tiers (need an account and a key): Groq https://api.groq.com/openai/v1 · OpenRouter https://openrouter.ai/api/v1 (models ending in :free)
# · Google Gemini https://generativelanguage.googleapis.com/v1beta/openai
# Groq (what the team uses for the event): LLM_BASE_URL=https://api.groq.com/openai/v1, LLM_MODEL=openai/gpt-oss-120b, LLM_REASONING_EFFORT=low
LLM_REASONING_EFFORT=
LLM_TIMEOUT=60
FS_PERSONA_PATH=../docs/SPROUT_PERSONA.md

# Sprout's voice assistant (POST /api/v1/assistant/voice, /chat). It reuses LLM_BASE_URL and LLM_API_KEY above.
# A faster model for talking (optional; default: LLM_MODEL)
VOICE_LLM_MODEL=openai/gpt-oss-20b
ASSISTANT_NAME=Sprout
# Speech to text: groq = Whisper in the cloud with the same key (no download) · local = faster-whisper on this machine
STT_ENGINE=groq
# Sprout's spoken voice: piper = soft voices on this server, pitched up like a kitten (get them once with
# bash voice_assistant/download_voices.sh, ~126 MB) · browser = the browser's own voice (no download, varies by system)
TTS_ENGINE=piper
PIPER_VOICE_ES=voice_assistant/models/es_MX-claude-high.onnx
PIPER_VOICE_EN=voice_assistant/models/en_US-amy-medium.onnx
# How much higher than the original voice (1.35 ≈ +5 semitones); the pace stays normal
TTS_PITCH=1.35

