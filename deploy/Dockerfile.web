# The web app, built and served by Caddy, which also forwards /api to the ML API (one origin: no CORS, one port).
# Build from the repository root through deploy/docker-compose.yml.
FROM node:22-alpine AS build
WORKDIR /src/web
COPY web/package.json web/package-lock.json ./
RUN npm ci
COPY web/ ./
# Same origin as the API (Caddy proxies /api): relative URLs work on any domain or IP
ENV VITE_ML_API_URL=/api/v1 VITE_ASK_URL=/api/v1/ask
RUN npx vite build

FROM caddy:2-alpine
COPY deploy/Caddyfile /etc/caddy/Caddyfile
COPY --from=build /src/web/dist /srv
