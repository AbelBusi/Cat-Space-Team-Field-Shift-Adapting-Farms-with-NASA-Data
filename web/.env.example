# Where the web app finds the Field Shift ML API (FastAPI, ml-api/). Required for the "What's ahead" screens.
VITE_ML_API_URL=http://localhost:8000/api/v1
# Sprout's open questions (optional): the ML API's /ask endpoint. Without it Sprout answers a few topics locally.
VITE_ASK_URL=http://localhost:8000/api/v1/ask
